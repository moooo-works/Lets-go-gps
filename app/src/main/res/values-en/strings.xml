    <!-- Health Connect permissions rationale (required by Play review) -->
    <string name="health_rationale_title">How we use health data</string>
    <string name="health_rationale_what_title">What we write</string>
    <string name="health_rationale_what_body">Steps only. This app never writes heart rate, weight, sleep, or any other health data.</string>
    <string name="health_rationale_why_title">Why we need this permission</string>
    <string name="health_rationale_why_body">This app is a testing tool for developers and QA engineers working on location-dependent features. During a route simulation it can convert the simulated travel distance into a step count and write it to Health Connect, so test scenarios that depend on step data can be verified end to end.</string>
    <string name="health_rationale_read_title">We read nothing</string>
    <string name="health_rationale_read_body">This app requests write access only. It never reads any of your health data from Health Connect.</string>
    <string name="health_rationale_control_title">You stay in control</string>
    <string name="health_rationale_control_body">This feature is off by default and must be turned on by you. You can revoke this app\'s permission at any time in Health Connect settings, and you can review or delete anything this app has written from within Health Connect.</string>
    <string name="health_rationale_close">Close</string>
